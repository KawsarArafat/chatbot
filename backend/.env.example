LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=llama-3.2-1b-instruct
LM_STUDIO_API_KEY=lm-studio
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHROMA_DIR=./storage/chroma
SQLITE_PATH=./storage/app.sqlite3
UPLOAD_DIR=./storage/pdfs
MAX_UPLOAD_MB=50
SEMANTIC_SIMILARITY_THRESHOLD=0.55
MIN_CHUNK_TOKENS=80
MAX_CHUNK_TOKENS=420
CHUNK_OVERLAP_SENTENCES=1
VECTOR_TOP_K=12
BM25_TOP_K=12
# Lower cosine distance means closer semantic evidence; out-of-scope matches abstain.
RETRIEVAL_MAX_COSINE_DISTANCE=0.45
RRF_K=60
RERANK_TOP_K=5
RECENT_MESSAGE_LIMIT=12
SUMMARY_EVERY_MESSAGES=8
MAX_CONTEXT_TOKENS=6000
OCR_ENABLED=false
